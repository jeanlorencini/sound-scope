{
  "manifest_version": 3,
  "name": "SoundScope — volume por site e por aba",
  "short_name": "SoundScope",
  "version": "1.0.0",
  "description": "Controle o volume de cada site em todas as abas, ou de uma aba só. Leve, sem rastreamento.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SoundScope",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Abrir o SoundScope"
    },
    "volume-up": {
      "suggested_key": { "default": "Alt+Shift+Up" },
      "description": "Aumentar o volume do site (+10)"
    },
    "volume-down": {
      "suggested_key": { "default": "Alt+Shift+Down" },
      "description": "Diminuir o volume do site (−10)"
    },
    "toggle-mute": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Silenciar ou ativar o som do site"
    }
  }
}
